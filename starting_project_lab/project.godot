; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="hud-starting-project"
run/main_scene="uid://bmwjmhf6p0hsm"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Globals="*uid://dmrf465hg46h8"

[display]

window/size/viewport_width=1120
window/size/viewport_height=630
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://assets/": "gray",
"res://assets/alien/": "red",
"res://assets/fonts/": "orange",
"res://assets/hud/": "yellow",
"res://assets/items/": "green",
"res://assets/tileset/": "blue",
"res://scenes/": "purple",
"res://scripts/": "pink"
}

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="platform"
2d_physics/layer_3="collectibles"

[physics]

3d/physics_engine="Jolt Physics"
2d/default_gravity=2000.0

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
